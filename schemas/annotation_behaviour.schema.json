{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsa4213:annotation_behaviour:0.1",
  "title": "Elena's post-game behavioural annotation (draft v0.1)",
  "description": "Output shape for the post-game LLM annotator and the two-human-reviewer check, per qa/annotation_rubric.md. Keyed by exchange_id so it merges against infra.eventlog.to_annotation_exchanges' overlay without field collisions: that overlay owns claim_ids/annotations/reported_pairs (Josh's finite catalogue); this schema owns everything in proposal section 5.2/5.4 that has no fixed case ID. Shape only; decision rules live in the rubric, not here.",
  "type": "object",
  "properties": {
    "game_id": { "type": "string", "minLength": 1 },
    "annotator_run_id": {
      "type": "string",
      "description": "Distinguishes the LLM annotator's output from a human reviewer's pass over the same game, e.g. 'llm_v1' or 'reviewer_A'."
    },
    "exchange_behaviour": {
      "type": "object",
      "description": "Keyed by exchange_id, matching the keys used in the overlay's 'exchanges' map.",
      "additionalProperties": { "$ref": "#/$defs/exchange_entry" }
    },
    "missed_required_disclosures": {
      "type": "array",
      "items": { "$ref": "#/$defs/missed_disclosure" }
    },
    "undiscovered_leads": {
      "type": "array",
      "description": "Required leads whose owner and every cue_speaker never appear anywhere in the detective-visible transcript -- no disclosure opportunity ever existed, so this is NOT a missed_required_disclosures violation. Computed directly from the event log (annotation.prompts.undiscovered_leads), not asserted by the LLM annotator.",
      "items": { "$ref": "#/$defs/undiscovered_lead" }
    },
    "voluntary_interaction": { "$ref": "#/$defs/voluntary_interaction" },
    "annotator_notes": { "type": "string" }
  },
  "required": ["game_id", "annotator_run_id", "exchange_behaviour", "missed_required_disclosures", "undiscovered_leads", "voluntary_interaction"],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "text": { "type": "string", "minLength": 1 }
      },
      "required": ["start", "end", "text"],
      "additionalProperties": false
    },
    "confidence": { "enum": ["high", "uncertain"] },
    "lead_follow_up": {
      "type": "object",
      "properties": {
        "newly_disclosed_lead_ids": { "type": "array", "items": { "type": "string" } },
        "is_follow_up_to_lead_id": { "type": ["string", "null"] },
        "follow_up_relevance": { "enum": ["relevant", "off_target", "no_opportunity", null] }
      },
      "required": ["newly_disclosed_lead_ids", "is_follow_up_to_lead_id", "follow_up_relevance"],
      "additionalProperties": false
    },
    "corroboration": {
      "type": "object",
      "properties": {
        "is_request": { "type": "boolean" },
        "target_subject": { "type": ["string", "null"] },
        "target_time": { "type": ["string", "null"] }
      },
      "required": ["is_request", "target_subject", "target_time"],
      "additionalProperties": false
    },
    "challenge": {
      "type": "object",
      "properties": {
        "is_challenge": { "type": "boolean" },
        "evidence_based": { "type": ["boolean", "null"] },
        "cited_claim_ids": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["is_challenge", "evidence_based", "cited_claim_ids"],
      "additionalProperties": false
    },
    "repeated_question": {
      "type": "object",
      "properties": {
        "is_repeat": { "type": "boolean" },
        "repeat_kind": { "enum": ["unnecessary", "expired_evidence_recovery", null] },
        "matches_exchange_id": { "type": ["string", "null"] }
      },
      "required": ["is_repeat", "repeat_kind", "matches_exchange_id"],
      "additionalProperties": false
    },
    "unsupported_addition": {
      "type": "object",
      "properties": {
        "citation": { "$ref": "#/$defs/citation" },
        "note": { "type": "string" }
      },
      "required": ["citation"],
      "additionalProperties": false
    },
    "withholding": {
      "type": "object",
      "properties": {
        "explicit_refusal": { "type": "boolean" },
        "partial_withholding": { "type": "boolean" }
      },
      "required": ["explicit_refusal", "partial_withholding"],
      "additionalProperties": false
    },
    "deception": {
      "type": "object",
      "properties": {
        "contains_false_statement": { "type": "boolean" },
        "authorised": { "type": ["boolean", "null"] },
        "claim_id_if_known": { "type": ["string", "null"] }
      },
      "required": ["contains_false_statement", "authorised", "claim_id_if_known"],
      "additionalProperties": false
    },
    "exchange_entry": {
      "type": "object",
      "properties": {
        "lead_follow_up": { "$ref": "#/$defs/lead_follow_up" },
        "corroboration": { "$ref": "#/$defs/corroboration" },
        "challenge": { "$ref": "#/$defs/challenge" },
        "repeated_question": { "$ref": "#/$defs/repeated_question" },
        "unsupported_additions": { "type": "array", "items": { "$ref": "#/$defs/unsupported_addition" } },
        "withholding": { "$ref": "#/$defs/withholding" },
        "deception": { "$ref": "#/$defs/deception" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "citation": { "$ref": "#/$defs/citation" }
      },
      "required": [
        "lead_follow_up", "corroboration", "challenge", "repeated_question",
        "unsupported_additions", "withholding", "deception", "confidence"
      ],
      "additionalProperties": false,
      "description": "citation is required whenever any positive (true/non-null/non-empty) label is present in this entry; omitted only when every field is a negative default."
    },
    "missed_disclosure": {
      "type": "object",
      "properties": {
        "lead_id_or_claim_id": { "type": "string" },
        "suspect": { "type": "string" },
        "note": { "type": "string" }
      },
      "required": ["lead_id_or_claim_id", "suspect"],
      "additionalProperties": false
    },
    "undiscovered_lead": {
      "type": "object",
      "properties": {
        "lead_id": { "type": "string" },
        "owner": { "type": "string" }
      },
      "required": ["lead_id", "owner"],
      "additionalProperties": false
    },
    "coordination_instance": {
      "type": "object",
      "properties": {
        "conversation_id": { "type": "string" },
        "proposal_to_conceal_or_align": { "type": "boolean" },
        "agreement": { "enum": ["agreed", "disagreed", "unclear"] },
        "subsequent_testimony_consistent_exchange_ids": { "type": "array", "items": { "type": "string" } },
        "citation": { "$ref": "#/$defs/citation" }
      },
      "required": ["conversation_id", "proposal_to_conceal_or_align", "agreement", "subsequent_testimony_consistent_exchange_ids", "citation"],
      "additionalProperties": false
    },
    "voluntary_interaction": {
      "type": "object",
      "properties": {
        "checkpoints_reached": { "type": "integer", "minimum": 0 },
        "coordination_instances": { "type": "array", "items": { "$ref": "#/$defs/coordination_instance" } }
      },
      "required": ["checkpoints_reached", "coordination_instances"],
      "additionalProperties": false
    }
  }
}
