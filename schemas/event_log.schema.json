{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsa4213:event_log:1.0",
  "title": "DSA4213 per-game event log line v1",
  "description": "Shape of ONE line of runs/<run_id>/<game_id>.jsonl. Shape only: ordering, ID contiguity, call-ID references and testimony freezing are checked by infra.eventlog.validate_events. Required keys per kind mirror infra.eventlog.REQUIRED_KEYS; a test keeps them equal. No network resolution is required.",
  "type": "object",
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "ts": {
      "type": "string",
      "minLength": 1
    },
    "game_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "game_start",
        "llm_call",
        "memory_view",
        "interrogation",
        "checkpoint_start",
        "invitation",
        "conversation",
        "checkpoint_end",
        "extraction",
        "contradiction_report",
        "accusation",
        "failure",
        "game_end"
      ]
    }
  },
  "required": [
    "seq",
    "ts",
    "game_id",
    "kind"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "game_start"
          }
        }
      },
      "then": {
        "properties": {
          "schema_version": {
            "const": "1.0"
          },
          "condition": {
            "enum": [
              "none",
              "raw",
              "ledger"
            ]
          },
          "k": {
            "type": "integer",
            "minimum": 1
          },
          "turn_budget": {
            "type": "integer",
            "minimum": 1
          },
          "accusation_budget": {
            "type": "integer",
            "minimum": 1
          },
          "decoding": {
            "type": "object"
          },
          "prompt_versions": {
            "type": "object"
          },
          "pricing": {
            "type": [
              "object",
              "null"
            ],
            "description": "input_per_million, output_per_million, optional reasoning_per_million, basis (source and date)"
          },
          "manifest_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "code_version": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "schema_version",
          "run_id",
          "case_id",
          "case_sha256",
          "condition",
          "k",
          "turn_budget",
          "accusation_budget",
          "seed",
          "model_id",
          "decoding",
          "prompt_versions",
          "pricing",
          "manifest_sha256",
          "code_version"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "llm_call"
          }
        }
      },
      "then": {
        "properties": {
          "call_id": {
            "type": "string",
            "pattern": "^c[0-9]{6}$"
          },
          "role": {
            "enum": [
              "detective",
              "suspect",
              "interpreter",
              "extractor",
              "annotator"
            ]
          },
          "agent_id": {
            "enum": [
              "detective",
              "suspect_1",
              "suspect_2",
              "suspect_3",
              "suspect_4",
              "suspect_5",
              "interpreter",
              "extractor",
              "annotator"
            ],
            "description": "Stable persona across games (decisions.md D3): suspects are numbered in the case's public suspect order"
          },
          "purpose": {
            "enum": [
              "question",
              "accusation",
              "interrogation_response",
              "invitation",
              "acceptance",
              "conversation_message",
              "conversation_reply",
              "intent_interpretation",
              "ledger_extraction",
              "annotation"
            ]
          },
          "phase": {
            "enum": [
              "through_first_accusation",
              "accusation_retries",
              "post_game_analysis"
            ]
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/message"
            }
          },
          "text": {
            "type": "string"
          },
          "usage": {
            "$ref": "#/$defs/usage"
          },
          "cost_usd": {
            "type": [
              "number",
              "null"
            ]
          },
          "latency_ms": {
            "type": "integer",
            "minimum": 0
          },
          "attempts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/attempt"
            }
          },
          "repair_used": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "ok",
              "transport_failure",
              "format_failure"
            ]
          },
          "tags": {
            "type": "object"
          }
        },
        "required": [
          "call_id",
          "role",
          "agent_id",
          "purpose",
          "phase",
          "model_id",
          "decoding",
          "response_schema",
          "max_output_tokens",
          "messages",
          "text",
          "parsed",
          "usage",
          "cost_usd",
          "finish_reason",
          "latency_ms",
          "attempts",
          "repair_used",
          "status",
          "tags"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "memory_view"
          }
        }
      },
      "then": {
        "properties": {
          "decision_index": {
            "type": "integer",
            "minimum": 1
          },
          "decision_type": {
            "enum": [
              "question",
              "accusation",
              "acceptance",
              "conversation_reply"
            ]
          },
          "window_exchange_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "memory_payload": {
            "description": "Exactly what was placed in the detective prompt: raw exchanges (raw), ledger entries (ledger), the latest exchange (none) or an empty list before the first exchange."
          }
        },
        "required": [
          "decision_index",
          "decision_type",
          "window_exchange_ids",
          "memory_payload",
          "call_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "interrogation"
          }
        }
      },
      "then": {
        "properties": {
          "interrogation_index": {
            "type": "integer",
            "minimum": 1
          },
          "exchange_index": {
            "type": "integer",
            "minimum": 1
          },
          "exchange_id": {
            "type": "string",
            "pattern": "^e[0-9]+$"
          },
          "question": {
            "type": "string"
          },
          "intent": {
            "type": "object"
          },
          "allowed_branches": {
            "type": "array",
            "description": "casework.allowed_content output; controller/evaluator-only, never a detective input"
          },
          "instructions": {
            "type": "object",
            "description": "casework.disclosure.branch_prompt output actually supplied to the suspect model"
          },
          "response": {
            "type": "string",
            "description": "Delivered unchanged; annotation spans are Python character offsets into this string"
          },
          "controller_matched": {
            "type": "object",
            "properties": {
              "claim_ids": {
                "type": "array"
              },
              "lead_ids": {
                "type": "array"
              },
              "retraction_ids": {
                "type": "array"
              }
            },
            "required": [
              "claim_ids",
              "lead_ids",
              "retraction_ids"
            ],
            "description": "Online bookkeeping passed to record_delivery; not an annotation"
          }
        },
        "required": [
          "interrogation_index",
          "exchange_index",
          "exchange_id",
          "suspect",
          "question",
          "question_call_id",
          "intent",
          "intent_call_id",
          "allowed_branches",
          "instructions",
          "selected_branch_id",
          "response",
          "response_call_id",
          "controller_matched"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "checkpoint_start"
          }
        }
      },
      "then": {
        "properties": {
          "checkpoint_index": {
            "type": "integer",
            "minimum": 1
          },
          "after_interrogation": {
            "type": "integer",
            "minimum": 1
          },
          "proposal_order": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "checkpoint_index",
          "after_interrogation",
          "proposal_order",
          "seed_used"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "invitation"
          }
        }
      },
      "then": {
        "properties": {
          "invitation_id": {
            "type": "string",
            "pattern": "^inv[0-9]+$"
          },
          "pass_no": {
            "enum": [
              1,
              2
            ]
          },
          "decision": {
            "enum": [
              "accepted",
              "rejected",
              "no_slot"
            ]
          }
        },
        "required": [
          "invitation_id",
          "checkpoint_index",
          "pass_no",
          "sender",
          "recipient",
          "decision",
          "invitation_call_id",
          "decision_call_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "conversation"
          }
        }
      },
      "then": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "description": "p<n> for suspect-only conversations, conv<n> for conversations with the detective"
          },
          "visibility": {
            "enum": [
              "private",
              "detective"
            ]
          },
          "exchange_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "e<t> when visibility is detective (enters detective memory), null when private"
          },
          "exchange_index": {
            "type": [
              "integer",
              "null"
            ]
          },
          "message": {
            "type": "string"
          },
          "reply": {
            "type": "string"
          },
          "controller_matched": {
            "type": "object",
            "properties": {
              "message_claim_ids": {
                "type": "array"
              },
              "reply_claim_ids": {
                "type": "array"
              },
              "proposal_claim_ids": {
                "type": "array"
              }
            },
            "required": [
              "message_claim_ids",
              "reply_claim_ids",
              "proposal_claim_ids"
            ]
          }
        },
        "required": [
          "conversation_id",
          "checkpoint_index",
          "visibility",
          "exchange_id",
          "exchange_index",
          "inviter",
          "recipient",
          "message",
          "reply",
          "message_call_id",
          "reply_call_id",
          "controller_matched"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "checkpoint_end"
          }
        }
      },
      "then": {
        "required": [
          "checkpoint_index",
          "invitations_sent",
          "accepted",
          "rejected",
          "conversations_completed"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "extraction"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "repaired",
              "failed"
            ]
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Ledger entries extracted from ONE delivered exchange; entry schema is owned by Aravindh and should carry speaker, text and source_span"
          },
          "failure_entry": {
            "type": [
              "object",
              "null"
            ],
            "description": "The explicit extraction-failure entry when status is failed"
          }
        },
        "required": [
          "exchange_id",
          "call_id",
          "status",
          "entries",
          "failure_entry"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "contradiction_report"
          }
        }
      },
      "then": {
        "properties": {
          "call_id": {
            "type": "string",
            "description": "The first accusation call that carried the report (proposal 5.3)"
          },
          "reported_pairs_raw": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "left": {
                  "$ref": "#/$defs/citation"
                },
                "right": {
                  "$ref": "#/$defs/citation"
                },
                "note": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "left",
                "right"
              ]
            },
            "description": "Aravindh's contradiction_report field from the first accusation output, as produced in play; claim IDs are resolved only after play in the annotation overlay"
          }
        },
        "required": [
          "call_id",
          "window_exchange_ids",
          "reported_pairs_raw"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "accusation"
          }
        }
      },
      "then": {
        "properties": {
          "attempt": {
            "enum": [
              1,
              2,
              3
            ]
          },
          "triple": {
            "type": "object",
            "properties": {
              "culprit": {
                "type": "string"
              },
              "weapon": {
                "type": "string"
              },
              "location": {
                "type": "string"
              }
            },
            "required": [
              "culprit",
              "weapon",
              "location"
            ],
            "additionalProperties": false
          },
          "valid": {
            "type": "boolean"
          },
          "correct": {
            "type": "boolean"
          },
          "feedback": {
            "type": "string",
            "description": "Whole-triple feedback only; never component hints"
          },
          "testimony_frozen": {
            "const": true
          }
        },
        "required": [
          "attempt",
          "triple",
          "valid",
          "correct",
          "feedback",
          "call_id",
          "exchange_index",
          "interrogations_used",
          "testimony_frozen"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "failure"
          }
        }
      },
      "then": {
        "required": [
          "stage",
          "reason",
          "call_id",
          "detail"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "game_end"
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "enum": [
              "solved_first",
              "solved_retry",
              "unsolved",
              "failed_run"
            ]
          },
          "attempts_used": {
            "type": "integer",
            "minimum": 0
          },
          "first_accusation_correct": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "component_correct": {
            "type": [
              "object",
              "null"
            ]
          },
          "cost": {
            "type": "object",
            "description": "infra.eventlog.summarise_cost output"
          }
        },
        "required": [
          "outcome",
          "attempts_used",
          "first_accusation_correct",
          "component_correct",
          "interrogations_used",
          "exchanges_total",
          "checkpoints_reached",
          "conversations",
          "invitations",
          "cost",
          "duration_s"
        ]
      }
    }
  ],
  "$defs": {
    "message": {
      "type": "object",
      "properties": {
        "role": {
          "enum": [
            "system",
            "user",
            "assistant"
          ]
        },
        "content": {
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "total_tokens"
      ],
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "properties": {
        "attempt_no": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "initial",
            "transport_retry",
            "format_repair"
          ]
        },
        "status": {
          "enum": [
            "ok",
            "transport_error",
            "format_error"
          ]
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "attempt_no",
        "kind",
        "status",
        "usage",
        "latency_ms",
        "error"
      ],
      "additionalProperties": false
    },
    "citation": {
      "type": "object",
      "properties": {
        "exchange_id": {
          "type": "string"
        },
        "quote": {
          "type": "string"
        }
      },
      "required": [
        "exchange_id",
        "quote"
      ]
    }
  }
}
